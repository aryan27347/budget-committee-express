// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Member {
    memberId        Int     @id @unique @map("member_id")
    fullName        String  @db.VarChar(100) @map("full_name")
    fatherName      String  @db.VarChar(100) @map("father_name")
    address         String  @db.VarChar(255)
    phoneNumber     String  @unique @db.VarChar(10) @map("phone_number")
    alternateNumber String? @db.VarChar(10) @map("alternate_number")
    dateOfBirth     String  @db.VarChar(10) @map("dob")
    shareAmount     Int     @default(0) @map("share_amount")
    loanAmount      Int     @default(0) @map("loan_amount")
    membershipFees  Int     @default(0) @map("membership_fees")
    role            Role    @default(USER)
    pin             String

    @@index([memberId, phoneNumber])
    @@map("members")
}

enum Role {
    USER
    ADMIN
}
